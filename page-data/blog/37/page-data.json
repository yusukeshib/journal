5ff1109b4801a619/09d21/IMG_0964.jpg 540w,\n/static/f0b1ecb5808173ff5ff1109b4801a619/47311/IMG_0964.jpg 1080w,\n/static/f0b1ecb5808173ff5ff1109b4801a619/0047d/IMG_0964.jpg 1620w,\n/static/f0b1ecb5808173ff5ff1109b4801a619/274e1/IMG_0964.jpg 2160w,\n/static/f0b1ecb5808173ff5ff1109b4801a619/b7c1f/IMG_0964.jpg 5712w\"\n        sizes=\"(max-width: 1080px) 100vw, 1080px\"\n        style=\"width:100%;height:100%;margin:0;vertical-align:middle;position:absolute;top:0;left:0;\"\n        loading=\"lazy\"\n        decoding=\"async\"\n      />\n  </a>\n    </span></p>\n<p>まぁ、そんなこんなでやっぱり飛行機は大嫌いで全然眠れないし時差ぼけにも弱いしで旅行は億劫だといつも感じる。今回はよく本(SF)を読んだ。世界中に知り合いがいるのはいいことだ。一緒に飲んだ一人はアーティストになったのだけど、今売れてきていてアトリエにも行ったけど素晴らしいアートだった。かっこいい。みんなで飲んだ時はみんな人生に対して真剣で、自分はそこまで深く考えずに生きているなぁ、と感じた。</p>","fields":{"slug":"/blog/37/"},"frontmatter":{"date":"May 12, 2025","title":"","description":null}},"previous":{"fields":{"slug":"/blog/36/"},"frontmatter":{"title":""}},"next":{"fields":{"slug":"/blog/38/"},"frontmatter":{"title":""}}},"pageContext":{"id":"18ecffef-4b92-5ab4-bad1-d14867600f9b","previousPostId":"b54937c1-da20-5cd0-a3a2-87e110b4af5c","nextPostId":"3e9f6174-aed0-55f1-876c-014263ab5821"}},"staticQueryHashes":["2841359383"],"slicesMap":{}}