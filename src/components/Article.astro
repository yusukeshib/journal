---
interface Props {
  title?: string
  date: Date
}

const { title, date } = Astro.props
const dateStr = new Intl.DateTimeFormat('ja', { dateStyle: 'full' }).format(date)
const heading = title || dateStr
---

<article itemscope itemtype="http://schema.org/Article">
  <header>
    <h3>{heading}</h3>
  </header>
  <section class="body" itemprop="articleBody">
    <slot />
  </section>
</article>

<style>
  article {
    margin: 0 0 1em 0;
  }

  header {
    margin: 0 0 2em 0;
  }

  .body {
    margin: 0 0 3em 0;
  }
</style>
