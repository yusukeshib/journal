---
interface Props {
  title?: string
  date: Date
}

const { title, date } = Astro.props
const dateStr = new Intl.DateTimeFormat('ja', { dateStyle: 'full' }).format(date)
const heading = title || dateStr
---

<article itemscope itemtype="http://schema.org/Article" class="mb-4">
  <header class="mb-8">
    <h3>{heading}</h3>
  </header>
  <section class="mb-12" itemprop="articleBody">
    <slot />
  </section>
</article>
