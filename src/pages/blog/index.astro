---
import Layout from '../../layouts/Layout.astro'
import { getSortedPosts, getPostUrl, excerpt } from '../../lib/posts'

const posts = await getSortedPosts()
---

<Layout pageTitle="/blog/">
  <h3>/blog/</h3>
  <ul class="list-none p-0">
    {posts.map(post => {
      const date = new Intl.DateTimeFormat('ja', { dateStyle: 'medium' }).format(post.data.date)
      return (
        <li class="truncate">
          <span class="mr-4">{date}</span>
          <a href={getPostUrl(post)}>
            {post.data.title || excerpt(post.body || '', 48)}
          </a>
        </li>
      )
    })}
  </ul>
</Layout>
