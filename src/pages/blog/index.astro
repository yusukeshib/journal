---
import Layout from '../../layouts/Layout.astro'
import { getSortedPosts, getPostUrl, excerpt } from '../../lib/posts'

const posts = await getSortedPosts()
---

<Layout pageTitle="/blog/">
  <h3>/blog/</h3>
  <ul class="post-list">
    {posts.map(post => {
      const date = new Intl.DateTimeFormat('ja', { dateStyle: 'medium' }).format(post.data.date)
      return (
        <li>
          <span class="date">{date}</span>
          <a href={getPostUrl(post)}>
            {post.data.title || excerpt(post.body || '', 48)}
          </a>
        </li>
      )
    })}
  </ul>
</Layout>

<style>
  .date {
    margin-right: 1em;
  }

  .post-list {
    list-style: none;
    padding: 0;
  }

  .post-list li {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
